// MakeHero.mjs (23 October 2026, 23:00 Paris): render one live day of the Plan as the article's opening image. / rend une journée réelle du Plan en image d'ouverture.
// Usage: node MakeHero.mjs [date]   (default 2026-10-24)
import { execFileSync } from 'node:child_process'
import fs from 'node:fs'
import path from 'node:path'
const { chromium } = await import('/Users/zenray/Create/Build/Productions/GithubProductions/ZenRayProgress/node_modules/playwright/index.mjs')
// Parameters. / Paramètres.
const P = { date: process.argv[2] || '2026-10-24', from: 8 * 60 + 30, to: 18 * 60 + 30, pxPerMin: 2.2, width: 1600, height: 900, accent: '#cc7c5e',
  chromium: process.env.HOME + '/Library/Caches/ms-playwright/chromium_headless_shell-1234/chrome-headless-shell-mac-arm64/chrome-headless-shell' }
const ROOT = path.resolve(path.dirname(new URL(import.meta.url).pathname), '..')
const OUT = path.join(ROOT, `Drafts/Article/assets/journee-${P.date}.png`)
const tool = path.join(process.env.HOME, '.claude/skills/zenray-calendar-plan/scripts/CalendarPlan.mjs')
let raw; try { raw = execFileSync('node', [tool, 'check', '--date', P.date, '--json']).toString() } catch (e) { raw = e.stdout.toString() }
const day = JSON.parse(raw)
const hh = (m) => `${String(Math.floor(m / 60)).padStart(2, '0')}:${String(m % 60).padStart(2, '0')}`
const x = (m) => 140 + (m - P.from) * P.pxPerMin
const ticks = []; for (let m = Math.ceil(P.from / 60) * 60; m <= P.to; m += 60) ticks.push(`<div class=tick style="left:${x(m)}px"><span class=num>${hh(m)}</span></div>`)
const bars = day.items.sort((a, b) => a.s - b.s).map((it, i) => `<div class=bar style="left:${x(it.s)}px;width:${(it.e - it.s) * P.pxPerMin}px;top:${250 + i * 120}px"><b class=num>${hh(it.s)}-${hh(it.e)}</b><span>${it.title.replace(/</g, '&lt;')}</span></div>`).join('')
const html = `<!doctype html><meta charset=utf-8><style>
@font-face{font-family:'GT Sectra LCG';src:url('file:///Users/zenray/Library/Fonts/GT-Sectra-LCGV-Regular-Italic.otf')}
@font-face{font-family:AnthropicSerif;src:url('file:///Users/zenray/Library/Fonts/AnthropicSerif-Regular.ttf')}
@font-face{font-family:InterVariable;src:url('file:///Users/zenray/Library/Fonts/InterVariable.ttf');font-weight:100 900}
body{margin:0;width:${P.width}px;height:${P.height}px;background:#1b1b1d;color:#f2f2f4;font-family:InterVariable;position:relative;overflow:hidden}
h1{font-family:'GT Sectra LCG';font-style:italic;font-weight:400;font-size:60px;margin:0;position:absolute;left:140px;top:70px}
p{position:absolute;left:140px;top:150px;margin:0;color:#a1a1a6;font-size:24px}
.num{font-family:AnthropicSerif;font-style:normal}.tick{position:absolute;top:210px;bottom:90px;border-left:1px solid rgba(255,255,255,.08)}.tick span{position:absolute;top:-28px;left:-24px;font-size:18px;color:#6e6e73}
.bar{position:absolute;height:92px;box-sizing:border-box;background:rgba(204,124,94,.16);border-left:4px solid ${P.accent};border-radius:10px;padding:12px 14px;overflow:hidden}
.bar b{display:block;font-weight:400;font-size:20px;color:${P.accent}}.bar span{display:block;font-size:19px;line-height:1.25;margin-top:4px;color:#f2f2f4}
.src{position:absolute;left:140px;bottom:36px;font-size:18px;color:#6e6e73}</style>
<h1>La journée du <span class=num>24</span> October <span class=num>2026</span></h1>
<p>Plan et Google Calendar fusionnés, relus après placement : <span class=num>${day.overlaps.length}</span> chevauchement.</p>${ticks.join('')}${bars}
<div class=src>CalendarPlan.mjs check --date ${P.date} · zenray-calendar-plan · 23 October 2026</div>`
const b = await chromium.launch({ executablePath: P.chromium })
const pg = await b.newPage({ viewport: { width: P.width, height: P.height } })
await pg.setContent(html); await pg.waitForTimeout(500)
await pg.screenshot({ path: OUT }); await b.close(); console.log(OUT, fs.statSync(OUT).size)
