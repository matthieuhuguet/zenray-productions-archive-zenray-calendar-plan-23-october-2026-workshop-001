-played, var(--zr-video-volume, 0%)) 100%),\n    linear-gradient(to right, rgba(255, 255, 255, 0.35) 0 var(--zr-video-buffered, var(--zr-video-volume, 0%)), rgba(255, 255, 255, 0.15) var(--zr-video-buffered, var(--zr-video-volume, 0%)) 100%);\n}\n.zr-video-volume::-webkit-slider-runnable-track { height: 3px; }\n.zr-video-seek::-webkit-slider-thumb,\n.zr-video-volume::-webkit-slider-thumb {\n  width: 12px;\n  height: 12px;\n  margin-top: -4px;\n  border: 0;\n  border-radius: 999px;\n  appearance: none;\n  -webkit-appearance: none;\n  background: #ffffff;\n  box-shadow: 0 1px 6px rgba(0, 0, 0, 0.4);\n  opacity: 0;\n  transition: opacity 0.2s ease;\n}\n.zr-video-volume::-webkit-slider-thumb { margin-top: -4.5px; }\n.zr-video-seek:hover::-webkit-slider-thumb,\n.zr-video-seek:focus-visible::-webkit-slider-thumb,\n.zr-video-volume:hover::-webkit-slider-thumb,\n.zr-video-volume:focus-visible::-webkit-slider-thumb { opacity: 1; }\n.zr-video-seek::-moz-range-track,\n.zr-video-volume::-moz-range-track { height: 4px; border-radius: 999px; background: rgba(255, 255, 255, 0.15); }\n.zr-video-volume::-moz-range-track { height: 3px; }\n.zr-video-seek::-moz-range-progress,\n.zr-video-volume::-moz-range-progress { height: 4px; border-radius: 999px; background: rgba(255, 255, 255, 0.95); }\n.zr-video-volume::-moz-range-progress { height: 3px; }\n.zr-video-seek::-moz-range-thumb,\n.zr-video-volume::-moz-range-thumb { width: 12px; height: 12px; border: 0; border-radius: 999px; opacity: 0; background: #ffffff; box-shadow: 0 1px 6px rgba(0,0,0,.4); }\n.zr-video-seek:hover::-moz-range-thumb,\n.zr-video-seek:focus-visible::-moz-range-thumb,\n.zr-video-volume:hover::-moz-range-thumb,\n.zr-video-volume:focus-visible::-moz-range-thumb { opacity: 1; }\n.zr-video-control-row { display: flex; min-width: 0; align-items: center; gap: 8px; color: rgba(255, 255, 255, 0.85); }\n.zr-video-control-sm { width: 44px; height: 44px; }\n.zr-video-control-md { width: 58px; height: 58px; }\n.zr-video-volume-pill { display: flex; align-items: center; gap: 12px; width: 240px; height: 44px; padding: 0 14px 0 16px; border-radius: 999px; }\n.zr-video-volume-pill .zr-video-volume { flex: 1; min-width: 0; }\n.zr-video-volume-toggle { display: inline-grid; width: 32px; height: 32px; flex: 0 0 auto; place-items: center; padding: 0; color: rgba(255, 255, 255, 0.82); border: 0; background: transparent; cursor: pointer; transition: color 0.2s ease; }\n.zr-video-volume-toggle:hover { color: #ffffff; }\n.zr-video-time { min-width: 0; color: rgba(255, 255, 255, 0.85) !important; font-family: var(--zr-police-mono); font-size: var(--zr-ui-md); font-weight: 400; font-variant-numeric: tabular-nums; letter-spacing: .01em; }\n.zr-video-time:last-child { text-align: right; }\n.zr-video-actions { position: relative; display: flex; align-items: center; gap: 8px; margin-left: auto; }\n.zr-video-options-pill { display: inline-flex; box-sizing: border-box; align-items: center; gap: 4px; height: 44px; padding: 2px 6px; border-radius: 999px; overflow: hidden; }\n.zr-video-option-button { display: inline-grid; width: 40px; height: 40px; place-items: center; flex: 0 0 auto; padding: 0; color: rgba(255, 255, 255, 0.8); border: 0; border-radius: 999px; background: transparent; cursor: pointer; transition: background-color 0.2s ease, color 0.2s ease; }\n.zr-video-settings-menu { position: absolute; right: 0; bottom: 52px; min-width: 165px; max-height: 320px; overflow: auto; padding: 8px; color: #ffffff !important; border-radius: 16px; background: rgba(14, 15, 18, 0.82); border: 1px solid rgba(255, 255, 255, 0.18); box-shadow: 0 16px 44px rgba(0, 0, 0, 0.55); backdrop-filter: blur(24px); -webkit-backdrop-filter: blur(24px); z-index: 40; }\n.zr-video-settings-menu .zr-ctrl-btn,\n.zr-video-settings-menu button { color: #ffffff !important; background: transparent; transition: background-color 0.15s ease, color 0.15s ease; }\n.zr-video-settings-menu .zr-ctrl-btn:hover,\n.zr-video-settings-menu button:hover,\n.zr-video-settings-menu .zr-ctrl-btn:focus-visible,\n.zr-video-settings-menu button:focus-visible { color: #ffffff !important; background: rgba(255, 255, 255, 0.16) !important; outline: none; }\n@media (max-width: 700px) {\n  .zr-video-controls { padding: 12px; }\n  .zr-video-top-left { top:12px; left:12px; }.zr-video-top-right { top:12px; right:12px; }\n  .zr-video-bottom-right { right:12px; bottom:66px; }.zr-video-bottom { right:12px; bottom:10px; left:12px; }\n  .zr-video-seek-pill { grid-template-columns: 62px minmax(0,1fr) 70px; gap: 14px; height: 56px; padding: 0 18px; }\n  .zr-video-control-row { gap: 5px; }\n  .zr-video-control-sm { width: 38px; height: 38px; }\n  .zr-video-control-md { width: 42px; height: 42px; }\n  .zr-video-volume-pill { width: 148px; height: 38px; padding: 0 10px 0 12px; gap: 6px; }\n  .zr-video-volume-toggle { width: 28px; height: 28px; }\n  .zr-video-time { font-size: var(--zr-ui-sm); }\n  .zr-video-options-pill { height: 38px; padding: 2px; }\n  .zr-video-option-button { width: 34px; height: 34px; }\n  .zr-video-play-center { width:72px; height:72px; }\n  .zr-video-transport { gap:24px; }\n}\n@media (prefers-reduced-motion: reduce) {\n  .zr-video-glass, .zr-video-controls { transition: none; }\n}\n\n@media (max-width: 480px) {\n  html, body { -webkit-text-size-adjust: 100%; overflow-x: hidden; }\n  img, video, canvas { max-width: 100%; }\n  .zr-safe-bottom { padding-bottom: calc(12px + env(safe-area-inset-bottom)); }\n  .zr-safe-top { padding-top: env(safe-area-inset-top); }\n}\n\n/* \"Compact search sidebar\" V9 (design ui-components-zenray-v9.html) : recherche multi-source de la\n   sidebar. Surfaces search + drop en matériau V9 (verre dégradé + rim + élévations, deux thèmes via\n   --g9-*). Un seul jeu de classes pour les deux états replié/déplié (SearchGroup) : seule la liste de\n   résultats + la pagination + le sens du chevron changent, jamais le style. */\n.zr-sbs-search,\n.zr-sbs-drop {\n  position: relative;\n  color: var(--g9-fg);\n  background: linear-gradient(135deg, var(--g9-glass-a), var(--g9-glass-b));\n  box-shadow:\n    var(--g9-outer-line),\n    inset 0 1px 0 var(--g9-rim-main),\n    inset 0 -1px 0 var(--g9-rim-main),\n    inset 0 2px 0 var(--g9-rim-soft),\n    inset 0 -2px 0 var(--g9-rim-soft),\n    inset 1px 0 0 var(--g9-rim-side),\n    inset -1px 0 0 var(--g9-rim-side),\n    var(--g9-elev-b);\n  backdrop-filter: blur(27px) saturate(169%);\n  -webkit-backdrop-filter: blur(27px) saturate(169%);\n}\n.zr-sbs-search { display: flex; align-items: center; gap: 7px; height: 36px; padding: 0 12px; border-radius: 999px; overflow: hidden; }\n.zr-sbs-search input { position: relative; z-index: 1; min-width: 0; flex: 1; border: 0; outline: 0; background: transparent; color: var(--g9-fg); font: 400 var(--zr-ui-lg)/1 var(--zr-police-sans); }\n.zr-sbs-search input::placeholder { color: var(--g9-muted); }\n.zr-sbs-drop { margin-top: 4px; padding: 10px 8px; border-radius: 16px; display: flex; flex-direction: column; overflow: hidden; max-height: 320px; overflow-y: auto; }\n.zr-sbs-group { position: relative; z-index: 1; padding: 7px 4px; }\n.zr-sbs-group + .zr-sbs-group { border-top: 1px solid color-mix(in srgb, var(--g9-fg) 10%, transparent); }\n.zr-sbs-group-head { display: flex; align-items: center; justify-content: space-between; padding: 0 2px 3px; }\n.zr-sbs-group-head h4 { margin: 0; color: var(--g9-soft); font: 400 var(--zr-ui-sm)/1 var(--zr-police-sans); text-transform: uppercase; letter-spacing: .05em; }\n.zr-sbs-chevron { width: 22px; height: 20px; display: grid; place-items: center; background: transparent; border: 0; cursor: pointer; color: var(--g9-muted); transition: transform var(--g9-timing) var(--g9-ease); }\n.zr-sbs-chevron.up { transform: rotate(180deg); }\n.zr-sbs-row { display: grid; grid-template-columns: 34px minmax(0,1fr) 22px; align-items: center; gap: 9px; width: 100%; padding: 5px 2px; border-radius: 8px; border: 0; background: transparent; text-align: left; cursor: pointer; color: inherit; transition: background-color var(--g9-timing) var(--g9-ease); }\n.zr-sbs-row:hover { background: color-mix(in srgb, var(--g9-fg) 8%, transparent); }\n.zr-sbs-thumb { width: 34px; height: 20px; border-radius: 4px; object-fit: cover; background: color-mix(in srgb, var(--g9-fg) 14%, transparent); flex-shrink: 0; }\n.zr-sbs-thumb.round { width: 22px; height: 22px; border-radius: 5px; }\n.zr-sbs-row strong { display: block; color: var(--g9-fg); font: 400 var(--zr-ui-md)/1.25 var(--zr-police-sans); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\n.zr-sbs-row small { display: block; color: var(--g9-muted); font: 400 var(--zr-ui-sm)/1.3 var(--zr-police-sans); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\n.zr-sbs-add { width: 22px; height: 22px; border-radius: 999px; display: grid; place-items: center; background: transparent; border: 0; color: var(--g9-muted); cursor: pointer; transition: background-color var(--g9-timing) var(--g9-ease), color var(--g9-timing) var(--g9-ease); }\n.zr-sbs-add:hover { background: color-mix(in srgb, var(--g9-fg) 14%, transparent); color: var(--g9-fg); }\n.zr-sbs-note { padding: 4px 2px; color: var(--g9-muted); font: 400 var(--zr-ui-sm)/1.3 var(--zr-police-sans); }\n.zr-sbs-pagination { display: flex; align-items: center; justify-content: flex-end; gap: 8px; padding: 6px 4px 0; color: var(--g9-muted); font: 400 var(--zr-ui-sm)/1 var(--zr-police-mono); }\n.zr-sbs-page-btn { width: 22px; height: 20px; display: grid; place-items: center; background: transparent; border: 0; color: inherit; cursor: pointer; }\n.zr-sbs-page-btn:disabled { opacity: .35; cursor: default; }\n/* Variante pilule de recherche de la Sidebar left (design workspace-search : h48, gap 12, icône 18). */\n/* HAUTEUR RAMENÉE À CELLE DE LA CLASSE DE BASE (2026-07-31, retour Matthieu « la search bar reste\n   trop grosse »). Cette variante imposait 48px là où `.zr-sbs-search` en vaut 36 : un tiers de plus\n   que la même barre partout ailleurs dans l'application, sans raison écrite nulle part. L'écart se\n   voyait surtout à côté de l'engrenage, qui paraissait alors désaligné ; corriger l'alignement seul\n   ne réglait rien, puisque la cause était la hauteur. Gap et padding suivent la même proportion. */\n.zr-sbs-search--sidebar { height: 36px; gap: 10px; padding: 0 14px; background: linear-gradient(135deg, var(--g9-toolbar-glass-a), var(--g9-toolbar-glass-b)); }\n.zr-sbs-search--sidebar input { font-size: var(--zr-ui-sm); font-weight: 400; }\n\n/* ── \"Sidebar left\" V9 (design ui-components-zenray-v9.html, section workspace-sidebar) ──────────\n   La classe s'AJOUTE à .zr-liquid sur l'aside (l'ancrage du PlayerBar cherche aside.zr-liquid — ne\n   jamais retirer cette classe) et surcharge son verre : dégradé NEUTRE charbon en dark (fix V9\n   anti-vert : glass-a .135 / glass-b .045), laiteux en light. Le liseré ::before de zr-liquid est\n   remplacé par le rim V9 en box-shadow. */\naside.zr-ws-sidebar {\n  --ws-side-a: rgba(255,255,255,.78);\n  --ws-side-b: rgba(226,230,235,.54);\n  color: var(--g9-fg);\n  background: linear-gradient(135deg, var(--ws-side-a), var(--ws-side-b));\n  box-shadow:\n    var(--g9-outer-line),\n    inset 0 1px 0 var(--g9-rim-main),\n    inset 0 -1px 0 var(--g9-rim-main),\n    inset 0 2px 0 var(--g9-rim-soft),\n    inset 0 -2px 0 var(--g9-rim-soft),\n    inset 1px 0 0 var(--g9-rim-side),\n    inset -1px 0 0 var(--g9-rim-side),\n    var(--g9-elev-a),\n    var(--g9-elev-b);\n  backdrop-filter: blur(27px) saturate(169%);\n  -webkit-backdrop-filter: blur(27px) saturate(169%);\n}\n/* DARK : redéclarer background + box-shadow ICI, pas seulement les variables. Diagnostic DOM\n   2026-07-19 : `.zr-dark .zr-liquid` (index.html, spécificité 0,2,0) BAT `aside.zr-ws-sidebar`\n   (0,1,1) et imposait ses vieux insets 1.5px + fond plat rgba(31,31,30,.5) -> liserés haut/bas\n   faux en dark. Ce sélecteur (0,2,1) reprend la main sans toucher aux autres .zr-liquid. */\n.zr-dark aside.zr-ws-sidebar,\naside.zr-ws-sidebar.zr-ws-sidebar--dark {\n  --ws-side-a: rgba(255,255,255,.135);\n  --ws-side-b: rgba(255,255,255,.045);\n  background: linear-gradient(135deg, var(--ws-side-a), var(--ws-side-b));\n  box-shadow:\n    var(--g9-outer-line),\n    inset 0 1px 0 var(--g9-rim-main),\n    inset 0 -1px 0 var(--g9-rim-main),\n    inset 0 2px 0 var(--g9-rim-soft),\n    inset 0 -2px 0 var(--g9-rim-soft),\n    inset 1px 0 0 var(--g9-rim-side),\n    inset -1px 0 0 var(--g9-rim-side),\n    var(--g9-elev-a),\n    var(--g9-elev-b);\n}\naside.zr-ws-sidebar::before { display: none; }\n\n/* ── LE LISERÉ DE LA SIDEBAR, SEUL (2026-08-21) ──────────────────────────────────────────────────\n   Matthieu voulait ce liseré-ci sur les groupes de la galerie, et j'avais posé `zr-liquid-rim` à la\n   place : « tu commences à ajouter plein d'effet c'est moche ». Il avait raison, ce sont deux\n   familles opposées. `zr-liquid-rim` est un BISEAU pour carte opaque — highlight 1,5px, ombre\n   interne, halo, plus une ombre portée de 32px. Celui-ci est un FILET, et rien d'autre : à\n   --g9-rim-ratio 0.20, la ligne du haut vaut rgba(255,255,255,.144) en sombre. On le voit à peine,\n   et c'est exactement le but.\n\n   Extrait de `aside.zr-ws-sidebar` SANS ses deux ombres d'élévation (--g9-elev-a/-b, 14px et 3px de\n   diffusion) : elles font sens sous un panneau qui flotte au-dessus de toute la page, jamais sous\n   une tuile de 200px posée dans une grille, où elles salissent la grille entière. Le reste est\n   identique au caractère près, et les jetons --g9-rim-* vivant sur :root et .zr-dark, le liseré\n   suit le thème tout seul. */\n.zr-ws-rim {\n  /* LE TRAIT EXTÉRIEUR EST LA SEULE DIFFÉRENCE ASSUMÉE AVEC LA SIDEBAR, et elle a une raison\n     mesurée. `--g9-outer-line` vaut `0 0 0 0 transparent` en thème CLAIR : la sidebar s'en passe\n     parce que son fond est un dégradé de verre qui détache déjà sa silhouette. Une tuile de groupe,\n     elle, est une carte PLATE en #FDFDFC posée sur un fond clair — avec les seuls filets internes à\n     rgba(34,37,43,.09), elle n'avait plus aucun bord visible en clair. C'est exactement le défaut\n     que le CLAUDE.md décrit : un liseré juste dans un thème et faux dans l'autre. On garde donc les\n     sept filets de la sidebar au caractère près, et on redonne au trait extérieur une valeur qui\n     existe dans les DEUX thèmes. */\n  box-shadow:\n    0 0 0 .72px rgb(34 37 43 / calc(0.50 * var(--g9-rim-ratio))),\n    inset 0 1px 0 var(--g9-rim-main),\n    inset 0 -1px 0 var(--g9-rim-main),\n    inset 0 2px 0 var(--g9-rim-soft),\n    inset 0 -2px 0 var(--g9-rim-soft),\n    inset 1px 0 0 var(--g9-rim-side),\n    inset -1px 0 0 var(--g9-rim-side);\n}\n.zr-dark .zr-ws-rim {\n  /* En sombre, le trait extérieur de la sidebar convient tel quel : il est déjà noir et visible. */\n  box-shadow:\n    var(--g9-outer-line),\n    inset 0 1px 0 var(--g9-rim-main),\n    inset 0 -1px 0 var(--g9-rim-main),\n    inset 0 2px 0 var(--g9-rim-soft),\n    inset 0 -2px 0 var(--g9-rim-soft),\n    inset 1px 0 0 var(--g9-rim-side),\n    inset -1px 0 0 var(--g9-rim-side);\n}\n.zr-ws-top { min-height: 25px; display: flex; justify-content: flex-end; align-items: center; padding: 0 4px; }\n.zr-ws-bare { width: 28px; height: 28px; padding: 0; display: grid; place-items: center; border: 0; border-radius: 8px; color: var(--g9-muted); background: transparent; cursor: pointer; transition: background-color var(--g9-timing) var(--g9-ease), color var(--g9-timing) var(--g9-ease); }\n.zr-ws-bare:hover { background: color-mix(in srgb, var(--g9-fg) 7%, transparent); color: var(--g9-fg); }\n/* Typo sidebar : consigne Matthieu 2026-07-19 (PRIME sur le design 17px/400) — fonts beaucoup\n   plus petites et fines : items 13.5px/300 (jamais plus gras que 300), headings mono 10px. */\n.zr-ws-heading { min-height: 24px; display: flex; align-items: center; gap: 8px; width: 100%; text-align: left; padding: 0 10px; margin: 9px 0 2px; border: 0; background: transparent; cursor: pointer; color: var(--g9-soft); font: 600 var(--zr-ui-xs)/1 var(--zr-police-sans); letter-spacing: .04em; text-transform: uppercase; }\n/* Le chevron passe APRÈS le texte (2026-08-16). Il ouvrait la ligne et décalait donc chaque rubrique\n   d'une quinzaine de pixels vers la droite, si bien qu'aucune ne s'alignait sur les items qu'elle coiffe.\n   Une seule règle suffit et ne touche pas au JSX, qui déclare ce bouton à deux endroits : le libellé est\n   un nœud de texte nu, donc un flex item anonyme d'ordre 0 que rien ne peut réordonner ; il suffit de\n   pousser le seul élément réel de la ligne, l'icône, en ordre 1. Le texte démarre alors au padding de\n   10 px, exactement celui des items. */\n.zr-ws-heading > * { order: 1; }\n/* Les RUBRIQUES de la sidebar (TOOLS, CREATE, GALLERY, APPS, SYSTEM), style simple et définitif après un\n   passage par le mono puis par la serif : la même police que les items, en petites capitales. Trois valeurs\n   seulement, et chacune répond à une raison. La graisse 600 détache la rubrique de ses items en 400 sans\n   avoir besoin d'être plus grande. La taille descend d'un palier sous celle des items, ce qui suffit à dire\n   la hiérarchie. Et l'interlettrage reste à .04em, juste de quoi aérer des capitales, là où les .16em hérités\n   du mono écartaient les lettres au point qu'on lisait le mot par morceaux. */\n.zr-ws-item { min-height: 26px; display: flex; align-items: center; gap: 7px; width: 100%; text-align: left; padding: 0 10px; border: 0; border-radius: 11px; background: transparent; cursor: pointer; color: var(--g9-fg); font-family: var(--zr-police-sans); font-size: var(--zr-ui-md); font-weight: 400; letter-spacing: -.015em; transition: background-color var(--g9-timing) var(--g9-ease), color var(--g9-timing) var(--g9-ease); }\n.zr-ws-item:hover { background: color-mix(in srgb, var(--g9-fg) 6%, transparent); }\n.zr-ws-item.active { color: #0a84ff; background: rgba(10, 132, 255, .13); }\n\n/* ══ THÈME GALERIE SUR LA SIDEBAR (2026-09-05, direction 02) ═══════════════════════════════════\n   Valeurs relevées dans templates/zenray-assets-mockups/02-galerie.html du skill, jamais devinées.\n\n   LE VERRE RESTE. Première version : un crème OPAQUE posé sur la sidebar, ce qui tuait le\n   Liquid Glass que Matthieu voulait garder. La teinte est donc un VOILE à 15 pour cent posé\n   par-dessus le verre, jamais un fond plein : on voit toujours au travers.\n\n   LES DEUX THÈMES. Première version encore : des couleurs fixes en !important, donc une sidebar\n   cassée dès qu'on passait en sombre. Chaque jeton a maintenant sa valeur sous .zr-dark. */\n:root {\n  --gal-voile: rgba(244, 242, 237, .15);\n  --gal-encre: rgba(34, 33, 30, .92);\n  --gal-encre-2: rgba(34, 33, 30, .62);\n  --gal-encre-3: rgba(34, 33, 30, .40);\n  --gal-filet: rgba(34, 33, 30, .13);\n  --gal-marque: #9A5B3C;\n  --gal-survol: rgba(34, 33, 30, .045);\n}\n.zr-dark {\n  --gal-voile: rgba(38, 36, 32, .15);\n  --gal-encre: rgba(255, 255, 255, .92);\n  --gal-encre-2: rgba(255, 255, 255, .62);\n  --gal-encre-3: rgba(255, 255, 255, .40);\n  --gal-filet: rgba(255, 255, 255, .13);\n  --gal-marque: #D89B76;\n  --gal-survol: rgba(255, 255, 255, .06);\n}\n\n/* Le voile se pose en calque, pas en fond : le backdrop-filter du verre continue d'agir. */\n.zr-ws-sidebar { position: relative; }\n.zr-ws-sidebar::after {\n  content: ''; position: absolute; inset: 0; z-index: 0;\n  background: var(--gal-voile); border-radius: inherit; pointer-events: none;\n}\n.zr-ws-sidebar > * { position: relative; z-index: 1; }\n\n/* La marque, en tête du drawer. Le nom en serif, le mot Progress en italique plus clair :\n   c'est la signature de la maquette, et elle manquait entièrement. */\n.zr-ws-marque {\n  display: flex; align-items: baseline; gap: 7px;\n  padding: 2px 10px 16px; user-select: none;\n  font-family: var(--zr-police-serif); font-weight: 350;\n  font-size: var(--zr-ui-2xl); letter-spacing: -.01em; color: var(--gal-encre);\n}\n.zr-ws-marque em { font-style: italic; font-weight: 300; color: var(--gal-encre-3); }\n\n/* Family titles (23 October 2026, Matthieu, design « V2 espace et GT Sectra italique »): no rule between families,\n   space instead (Gestalt proximity), GT Sectra LCG Regular italic. All values are the tokens just below.\n   FR : titres de famille sans filet, de l'espace à la place, GT Sectra LCG Regular italique ; valeurs = jetons ci-dessous. */\n:root {\n  --zr-nav-head-gap: 2px;    /* space between a family title and its first entry */\n  /* 26 October 2026 (Matthieu, values chosen on the mockup designs/2026-10-26-sidebar-literata-gt-standard): the left sidebar only.\n     Family titles in Literata (weight and italic adjustable), every word of the list in GT Standard L. One token per value.\n     FR : sidebar de gauche seulement ; titres de famille en Literata, liste en GT Standard L ; une valeur = un jeton. */\n  --sb-title-font: 'Literata', 'Hiragino Mincho ProN W3', Georgia, serif;\n  --sb-title-weight: 500;\n  --sb-title-style: italic;\n  --sb-title-size: 17px;\n  --sb-title-track: -.01em;\n  --sb-zone-gap: 36px;       /* space between two families */\n  --sb-ui-font: 'GT Standard L', 'Hiragino Sans W4', 'Hiragino Sans', sans-serif;\n  --sb-ui-size: 15px;\n  --sb-ui-weight: 400;\n  --sb-ui-track: -.015em;\n  --sb-item-height: 32px;\n  --sb-active-weight: 400;\n}\n@font-face { font-family: 'GT Standard L'; src: url('/fonts/GT-Standard-L-Regular.woff2') format('woff2'); font-weight: 400; font-style: normal; font-display: swap; }\n@font-face { font-family: 'GT Standard L'; src: url('/fonts/GT-Standard-L-Bold.woff2') format('woff2'); font-weight: 700; font-style: normal; font-display: swap; }\n@font-face { font-family: 'Literata'; src: url('/fonts/Literata-latin.woff2') format('woff2'); font-weight: 200 900; font-style: normal; font-display: swap; }\n@font-face { font-family: 'Literata'; src: url('/fonts/Literata-Italic-latin.woff2') format('woff2'); font-weight: 200 900; font-style: italic; font-display: swap; }\n@font-face { font-family: 'GT Sectra LCG'; src: url('/fonts/GT-Sectra-LCGV-Regular-Italic.woff2') format('woff2'); font-weight: 400; font-style: italic; font-display: swap; }\n.zr-ws-heading {\n  color: var(--gal-encre) !important;\n  font-family: var(--sb-title-font) !important;\n  font-style: var(--sb-title-style) !important;\n  font-size: var(--sb-title-size) !important;\n  font-weight: var(--sb-title-weight) !important;\n  letter-spacing: var(--sb-title-track) !important;\n  text-transform: none !important;\n  border-top: 0;\n  padding-top: 0 !important;\n  margin: var(--sb-zone-gap) 0 var(--zr-nav-head-gap) !important;\n}\n.zr-ws-sidebar .zr-ws-heading:first-child, .zr-ws-sidebar > div > .zr-ws-heading:first-child { margin-top: 0 !important; }\n\n.zr-ws-subheading {\n  display: flex; align-items: center; gap: 9px;\n  min-height: 14px; padding: 2px 8px 5px; margin: 6px 0 0;\n  color: var(--gal-encre-3);\n  font: 400 var(--zr-ui-3xs)/1 var(--zr-police-sans);\n  letter-spacing: .16em; text-transform: uppercase; user-select: none;\n}\n.zr-ws-subheading::after { content: ''; flex: 1; height: 1px; background: var(--gal-filet); }\n\n/* L'accent est employé au FILET et jamais à l'aplat : une barre de 2 px sur 15 de haut,\n   c'est tout le parti pris de la Galerie. */\n.zr-ws-item {\n  position: relative;\n  min-height: var(--sb-item-height) !important;\n  padding: 0 8px 0 12px !important;\n  color: var(--gal-encre-2) !important;\n}\n/* 26 October 2026: every word of the sidebar list, the search field included, in GT Standard L (tokens --sb-ui-*). */\n.zr-ws-sidebar .zr-ws-item, .zr-ws-sidebar .zr-sbs-search, .zr-ws-sidebar .zr-sbs-search input {\n  font-family: var(--sb-ui-font); font-size: var(--sb-ui-size); font-weight: var(--sb-ui-weight); letter-spacing: var(--sb-ui-track);\n}\n.zr-ws-sidebar .zr-ws-item.active { font-weight: var(--sb-active-weight); }\n.zr-ws-item:hover { background: var(--gal-survol) !important; color: var(--gal-encre) !important; }\n.zr-ws-item::before {\n  content: ''; position: absolute; left: 0; top: 50%; transform: translateY(-50%);\n  width: 2px; height: 0; border-radius: 2px; background: var(--gal-marque);\n  transition: height .34s cubic-bezier(.16, 1, .3, 1);\n}\n.zr-ws-item.active {\n  color: var(--gal-encre) !important; background: transparent !important; font-weight: 500;\n}\n.zr-ws-item.active::before { height: 15px; }\n\n/* ══ LA FUSION, SUR ZENRAY ASSETS SEULEMENT (2026-09-07) ═══════════════════════════════════════\n   Sa demande : la barre latérale et le contenu ne forment plus qu'un bloc, en 0,35 seconde, et\n   « ça doit rester comme dans Create le scrolling à droite, tu dois couper et ajuster les bords\n   en bas, tout doit être parfaitement ajusté ».\n\n   CE QUI ÉTAIT FAUX DANS MA PREMIÈRE VERSION, et il l'a vu tout de suite. Je n'avais fermé que\n   le padding gauche et arrondi deux coins : cosmétique. Mesuré, le panneau d'Assets faisait\n   5 195 px de haut et descendait sous la fenêtre, parce que sa vue ne reçoit qu'un `minHeight`\n   sans borne, là où Create pose `height: calc(100vh - 132px)` avec `overflow: hidden` et laisse\n   le défilement à un enfant. Deux surfaces qui ne se terminent pas au même endroit ne fusionnent\n   jamais, quel que soit le soin mis aux rayons.\n\n   LA GÉOMÉTRIE EST DONC RECOPIÉE DE CREATE, mesurée sur lui : haut à 70, bas à 42, soit une\n   hauteur de 100vh moins 112. Les deux surfaces partagent exactement ces bornes, se touchent au\n   pixel, et seuls les quatre coins EXTÉRIEURS restent arrondis. Le bloc se lit alors comme une\n   seule pièce, et c'est la div racine, leur parent commun, qui les tient alignées.\n\n   LE DÉFILEMENT PASSE À L'INTÉRIEUR, comme dans Create : le panneau est borné et ne déborde\n   plus, c'est le contenu qui glisse dedans. La barre latérale reçoit le même traitement, avec sa\n   barre de défilement masquée : la règle du projet interdit une scrollbar VISIBLE dans le\n   drawer, et elle reste tenue. */\n:root { --zr-fusion-haut: 70px; --zr-fusion-bas: 42px; --zr-fusion-rayon: 26px; }\n\naside.zr-ws-sidebar,\n.zr-scene,\n.zr-stage {\n  transition: padding var(--zr-fusion-duree, .35s) cubic-bezier(.16, 1, .3, 1),\n              margin var(--zr-fusion-duree, .35s) cubic-bezier(.16, 1, .3, 1),\n              border-radius var(--zr-fusion-duree, .35s) cubic-bezier(.16, 1, .3, 1),\n              box-shadow var(--zr-fusion-duree, .35s) cubic-bezier(.16, 1, .3, 1);\n}\n\n/* Tout est borne, donc la scene n'a plus rien a faire glisser : sans ce verrou, deux\n   defilements se superposent et le bloc entier peut se decoller du haut. */\n/* 3 October 2026, 15:49 CEST: one shared top and bottom anchor; only docked panels join along their inner edge. */\n.zr-fusion .zr-scene { padding-top: var(--zr-fusion-haut) !important; padding-bottom: var(--zr-fusion-bas) !important; overflow-y: hidden !important; }\n.zr-fusion-docked .zr-scene { padding-left: 0 !important; }\n.zr-fusion.zr-fusion-docked aside.zr-ws-sidebar { position: relative !important; top: auto !important; margin-top: var(--zr-fusion-haut) !important; height: calc(100dvh - var(--zr-fusion-haut) - var(--zr-fusion-bas)); overflow-x: hidden; overflow-y: auto; scrollbar-width: thin; }\n.zr-fusion.zr-fusion-docked aside.zr-ws-sidebar::-webkit-scrollbar { width: 6px; }\n.zr-fusion:not(.zr-fusion-docked) .zr-stage { border-radius: var(--zr-fusion-rayon) !important; }\n\n/* 9 October 2026, 01:22 CEST: Keep the anchored sidebar independently scrollable in every view. */\naside.zr-ws-sidebar.zr-sidebar-docked {\n  box-sizing: border-box;\n  max-height: calc(100dvh - 82px);\n  overflow-x: hidden;\n  overflow-y: auto;\n  overscroll-behavior-y: contain;\n  scrollbar-width: thin;\n}\naside.zr-ws-sidebar.zr-sidebar-docked::-webkit-scrollbar { width: 6px; }\n\n.zr-fusion-docked aside.zr-ws-sidebar {\n  /* BORDER-BOX, sans quoi le padding s'AJOUTE a la hauteur calculee : la barre laterale\n     depassait de 39 px et le panneau de 50, exactement leurs paddings verticaux. Un plafond\n     pose en content-box ne plafonne rien, il decale. */\n  box-sizing: border-box;\n  margin-bottom: var(--zr-fusion-bas) !important;\n  max-height: calc(100dvh - var(--zr-fusion-haut) - var(--zr-fusion-bas));\n  overflow-y: auto;\n  scrollbar-width: none;\n  border-radius: var(--zr-fusion-rayon) 0 0 var(--zr-fusion-rayon) !important;\n}\n.zr-fusion-docked aside.zr-ws-sidebar::-webkit-scrollbar { width: 0; height: 0; }\n.zr-fusion-docked aside.zr-ws-sidebar::after {\n  border-radius: var(--zr-fusion-rayon) 0 0 var(--zr-fusion-rayon);\n}\n\n/* 9 October 2026, 01:40 CEST: Expose a small draggable thumb on the docked sidebar scroll area. */\naside.zr-ws-sidebar.zr-sidebar-docked {\n  scrollbar-color: color-mix(in srgb, var(--g9-fg) 40%, transparent) transparent;\n}\naside.zr-ws-sidebar.zr-sidebar-docked::-webkit-scrollbar { width: 8px; height: 8px; }\naside.zr-ws-sidebar.zr-sidebar-docked::-webkit-scrollbar-track { background: transparent; }\naside.zr-ws-sidebar.zr-sidebar-docked::-webkit-scrollbar-thumb {\n  background-color: color-mix(in srgb, var(--g9-fg) 38%, transparent);\n  background-clip: padding-box;\n  border: 2px solid transparent;\n  border-radius: 999px;\n}\naside.zr-ws-sidebar.zr-sidebar-docked::-webkit-scrollbar-thumb:hover {\n  background-color: color-mix(in srgb, var(--g9-fg) 58%, transparent);\n}\n.zr-fusion-docked aside.zr-ws-sidebar.zr-sidebar-docked { scrollbar-width: thin; }\n.zr-fusion-docked aside.zr-ws-sidebar.zr-sidebar-docked::-webkit-scrollbar { width: 8px; height: 8px; }\n\n.zr-fusion .zr-stage {\n  box-sizing: border-box;\n  height: calc(100dvh - var(--zr-fusion-haut) - var(--zr-fusion-bas));\n  min-height: 0 !important;\n  overflow: hidden !important;\n  display: flex;\n  flex-direction: column;\n  border-radius: 0 var(--zr-fusion-rayon) var(--zr-fusion-rayon) 0 !important;\n}\n/* Le contenu prend toute la place restante et défile DEDANS, jamais la page. */\n.zr-fusion .zr-stage > * { flex: 1 1 auto; min-height: 0; overflow-y: auto; }\n\n@media (prefers-reduced-motion: reduce) { :root { --zr-fusion-duree: 0s; } }\n\n/* ── \"Create path bar + empty folders overlay\" V9 (design workspace-shell/toolbar/blank) ─────────\n   Le stage Finder devient le shell (verre teinté par thème, radius 26, padding 10) ; la barre est une\n   GRILLE de quatre surfaces séparées (path pill · searchbar pill · bouton ⋯ · bouton + New bleu),\n   plus une pilule englobante ; la zone dossiers est le \"blank\" (verre atténué, radius 20). */\n.zr-ws-shell {\n  /* MÊMES valeurs de verre que aside.zr-ws-sidebar (retour Matthieu 2026-07-20 : \"le fond de Create et\n     celui de la sidebar devraient logiquement être identiques puisque le HTML les traite pareil\" -- le\n     :is() du fichier v14 donne à workspace-sidebar ET workspace-shell le même glass-a/-b). Avant : le\n     shell avait son propre couple (dark charbon opaque .48/.76) très différent de la sidebar. */\n  --ws-shell-a: rgba(255,255,255,.78);\n  --ws-shell-b: rgba(226,230,235,.54);\n  border-radius: 26px !important;\n  color: var(--g9-fg);\n  background: linear-gradient(135deg, var(--ws-shell-a), var(--ws-shell-b)) !important;\n  box-shadow:\n    var(--g9-outer-line),\n    inset 0 1px 0 var(--g9-rim-main),\n    inset 0 -1px 0 var(--g9-rim-main),\n    inset 0 2px 0 var(--g9-rim-soft),\n    inset 0 -2px 0 var(--g9-rim-soft),\n    inset 1px 0 0 var(--g9-rim-side),\n    inset -1px 0 0 var(--g9-rim-side),\n    var(--g9-elev-a),\n    var(--g9-elev-b) !important;\n  backdrop-filter: blur(27px) saturate(169%) !important;\n  -webkit-backdrop-filter: blur(27px) saturate(169%) !important;\n}\n.zr-dark .zr-ws-shell { --ws-shell-a: rgba(255,255,255,.135); --ws-shell-b: rgba(255,255,255,.045); }\n.zr-ws-toolbar { display: grid; grid-template-columns: minmax(0,1fr) minmax(140px,300px) 42px auto; align-items: center; gap: 9px; }\n.zr-ws-path,\n.zr-ws-searchbar {\n  box-sizing: border-box;\n  height: 42px;\n  border-radius: 999px;\n  display: flex;\n  align-items: center;\n  min-width: 0;\n  color: var(--g9-muted);\n  font-size: var(--zr-ui-md);\n  background: linear-gradient(135deg, var(--g9-glass-a), var(--g9-glass-b));\n  box-shadow:\n    var(--g9-outer-line),\n    inset 0 1px 0 var(--g9-rim-main),\n    inset 0 -1px 0 var(--g9-rim-main),\n    inset 0 2px 0 var(--g9-rim-soft),\n    inset 0 -2px 0 var(--g9-rim-soft),\n    inset 1px 0 0 var(--g9-rim-side),\n    inset -1px 0 0 var(--g9-rim-side),\n    var(--g9-elev-b);\n  backdrop-filter: blur(27px) saturate(169%);\n  -webkit-backdrop-filter: blur(27px) saturate(169%);\n}\n.zr-ws-path { padding: 0 13px 0 16px; gap: 9px; background: linear-gradient(135deg, var(--g9-toolbar-glass-a), var(--g9-toolbar-glass-b)); }\n.zr-ws-searchbar { padding: 0 15px; gap: 9px; background: linear-gradient(135deg, var(--g9-toolbar-glass-a), var(--g9-toolbar-glass-b)); }\n.zr-ws-searchbar input { min-width: 0; flex: 1; border: 0; outline: 0; background: transparent; color: var(--g9-fg); font-size: var(--zr-ui-xs); font-weight: 400; }\n.zr-ws-searchbar input::placeholder { color: var(--g9-muted); opacity: .8; }\n/* Toggle \"Search\" cachable (2026-07-19) : chevron discret dans la pilule ouverte ; pilule compacte\n   texte \"Search\" quand repliée -- même logique cachable que les zones Create/Apps/System. */\n.zr-ws-search-toggle { flex-shrink: 0; display: inline-flex; align-items: center; gap: 6px; border: 0; background: transparent; color: var(--g9-muted); cursor: pointer; padding: 0; }\n.zr-ws-search-toggle:hover { color: var(--g9-fg); }\n.zr-ws-search-toggle-closed { justify-self: start; width: fit-content; height: 42px; padding: 0 15px; border-radius: 999px; color: var(--g9-fg); font-family: var(--zr-police-sans); font-size: var(--zr-ui-xs); font-weight: 400;\n  background: linear-gradient(135deg, var(--g9-toolbar-glass-a), var(--g9-toolbar-glass-b));\n  box-shadow: var(--g9-outer-line), inset 0 1px 0 var(--g9-rim-main), inset 0 -1px 0 var(--g9-rim-main), inset 0 2px 0 var(--g9-rim-soft), inset 0 -2px 0 var(--g9-rim-soft), inset 1px 0 0 var(--g9-rim-side), inset -1px 0 0 var(--g9-rim-side), var(--g9-elev-b);\n  backdrop-filter: blur(27px) saturate(169%); -webkit-backdrop-filter: blur(27px) saturate(169%);\n}\n/* Cartes Skills (App.jsx SkillCardRow, 2026-07-19) : vivaient encore sur l'ancien .zr-liquid (verre\n   générique hors du système à un seul paramètre) -- retour Matthieu \"cohérence design\", même recette\n   V9/rim 20% que le reste (Create path bar, sidebar, players). */\n.zr-skill-card {\n  border: 0; cursor: pointer; border-radius: 22px; padding: 14px 16px;\n  color: var(--g9-fg);\n  background: linear-gradient(135deg, var(--g9-glass-a), var(--g9-glass-b));\n  box-shadow:\n    var(--g9-outer-line),\n    inset 0 1px 0 var(--g9-rim-main),\n    inset 0 -1px 0 var(--g9-rim-main),\n    inset 0 2px 0 var(--g9-rim-soft),\n    inset 0 -2px 0 var(--g9-rim-soft),\n    inset 1px 0 0 var(--g9-rim-side),\n    inset -1px 0 0 var(--g9-rim-side),\n    var(--g9-elev-a),\n    var(--g9-elev-b);\n  backdrop-filter: blur(27px) saturate(169%);\n  -webkit-backdrop-filter: blur(27px) saturate(169%);\n  transition: transform var(--g9-timing) var(--g9-ease);\n}\n.zr-skill-card:hover { transform: scale(1.008); }\n.zr-skill-card:active { transform: scale(.992); }\n.zr-ws-more-btn {\n  box-sizing: border-box;\n  width: 42px; height: 42px; min-height: 42px; padding: 0; flex: 0 0 42px;\n  display: grid; place-items: center;\n  border: 0; border-radius: 999px; cursor: pointer;\n  color: var(--g9-fg);\n  background: linear-gradient(135deg, var(--g9-glass-a), var(--g9-glass-b));\n  box-shadow:\n    var(--g9-outer-line),\n    inset 0 1px 0 var(--g9-rim-main),\n    inset 0 -1px 0 var(--g9-rim-main),\n    inset 0 2px 0 var(--g9-rim-soft),\n    inset 0 -2px 0 var(--g9-rim-soft),\n    var(--g9-elev-b);\n  backdrop-filter: blur(27px) saturate(169%);\n  -webkit-backdrop-filter: blur(27px) saturate(169%);\n  transition: transform var(--g9-timing) var(--g9-ease), filter var(--g9-timing) var(--g9-ease);\n}\n.zr-ws-more-btn:hover { filter: brightness(1.06); }\n.zr-ws-more-btn:active { transform: scale(.95); }\n/* + New : bleu exact du design (#3b82f7), contenu réellement centré, rim par thème. */\n.zr-ws-new-btn {\n  box-sizing: border-box;\n  width: 112px; min-width: 112px; height: 42px; min-height: 42px; padding: 0 15px; flex: 0 0 112px;\n  display: inline-flex; align-items: center; justify-content: center; gap: 7px;\n  border: 0; border-radius: 999px; cursor: pointer;\n  line-height: 1; white-space: nowrap;\n  color: #fff !important;\n  background: #3b82f7 !important;\n  font-size: var(--zr-ui-md); font-weight: 400;\n  box-shadow:\n    inset 0 1px 0 var(--g9-rim-main),\n    inset 0 -1px 0 var(--g9-rim-main),\n    inset 0 2px 0 var(--g9-rim-soft),\n    inset 0 -2px 0 var(--g9-rim-soft),\n    0 8px 23px rgba(59,130,247,.24);\n  transition: transform var(--g9-timing) var(--g9-ease), filter var(--g9-timing) var(--g9-ease);\n}\n.zr-dark .zr-ws-new-btn {\n  box-shadow:\n    inset 0 1px 0 rgba(255,255,255,.46),\n    inset 0 -1px 0 rgba(255,255,255,.46),\n    inset 0 2px 0 rgba(255,255,255,.14),\n    inset 0 -2px 0 rgba(255,255,255,.14),\n    0 8px 23px rgba(59,130,247,.28);\n}\n.zr-ws-new-btn:hover { filter: brightness(1.07); }\n.zr-ws-new-btn:active { transform: scale(.97); }\n.zr-ws-blank {\n  --ws-blank-a: rgba(255,255,255,.55);\n  --ws-blank-b: rgba(230,233,238,.42);\n  border-radius: 20px;\n  overflow: hidden;\n  background: linear-gradient(135deg, var(--ws-blank-a), var(--ws-blank-b));\n  box-shadow:\n    inset 0 1px 0 var(--g9-rim-main),\n    inset 0 -1px 0 var(--g9-rim-main),\n    inset 0 2px 0 var(--g9-rim-soft),\n    inset 0 -2px 0 var(--g9-rim-soft),\n    inset 1px 0 0 var(--g9-rim-side),\n    inset -1px 0 0 var(--g9-rim-side),\n    0 10px 28px rgba(62,67,78,.08),\n    0 2px 8px rgba(62,67,78,.05);\n}\n.zr-dark .zr-ws-blank {\n  --ws-blank-a: rgba(27,32,35,.72);\n  --ws-blank-b: rgba(25,22,20,.78);\n  box-shadow:\n    inset 0 1px 0 var(--g9-rim-main),\n    inset 0 -1px 0 var(--g9-rim-main),\n    inset 0 2px 0 var(--g9-rim-soft),\n    inset 0 -2px 0 var(--g9-rim-soft),\n    inset 1px 0 0 var(--g9-rim-side),\n    inset -1px 0 0 var(--g9-rim-side),\n    0 10px 28px rgba(0,0,0,.16),\n    0 2px 8px rgba(0,0,0,.11);\n}\n@media (max-width: 900px) {\n  .zr-ws-toolbar { grid-template-columns: minmax(0,1fr) 42px auto; }\n  .zr-ws-searchbar { display: none; }\n}\n\n/* ── Badge play des tuiles audio/playlist (Create, 2026-07-20) ────────────────────────────────────\n   Clic = lecture immédiate dans le mini-player global (pas d'ouverture de ZenRay Audio). Au survol,\n   un arc blanc tourne autour du rond façon aiguille de chargement -- un tour en 0.35s (la durée\n   d'animation standard du site), en boucle tant que le curseur reste dessus. Arc blanc dans les deux\n   thèmes : le badge lui-même est toujours sombre (rgba(18,18,20,.62)). */\n.zr-play-badge { position: relative; }\n.zr-play-badge::after {\n  content: '';\n  position: absolute;\n  inset: -3px;\n  border-radius: 999px;\n  border: 1.5px solid transparent;\n  border-top-color: #fff;\n  opacity: 0;\n  pointer-events: none;\n  transition: opacity .15s ease;\n}\n.zr-play-badge:hover::after { opacity: 1; animation: zr-play-badge-spin .35s linear infinite; }\n@keyframes zr-play-badge-spin { to { transform: rotate(360deg); } }\n@media (prefers-reduced-motion: reduce) { .zr-play-badge:hover::after { animation: none; } }\n\n\n/* ── LE CORPS DE PAGE ─────────────────────────────────────────────────────────\n   Deux fautes payées ici, écrites pour ne pas les rejouer. La première : une garde « si la classe n'est pas\n   déjà dans le fichier » a sauté l'écriture de la règle, parce que `.bn-block-content` y figurait ailleurs —\n   la variable existait donc sans que rien ne la consomme. La seconde : BlockNote pose lui-même `font-size`\n   sur `.bn-block-content`, et une règle de même spécificité perdait en silence. On cible donc les blocs PAR\n   LEUR TYPE, l'attribut apportant la spécificité qui manquait, et on laisse les TITRES tranquilles, qui\n   tirent leur taille de leur niveau. Le markdown déjà rendu suit la même variable, sinon un aperçu et sa page\n   n'auraient pas la même taille de texte. */\n.bn-block-content[data-content-type=\"paragraph\"],\n.bn-block-content[data-content-type=\"bulletListItem\"],\n.bn-block-content[data-content-type=\"numberedListItem\"],\n.bn-block-content[data-content-type=\"checkListItem\"],\n.bn-block-content[data-content-type=\"quote\"],\n.bn-block-content[data-content-type=\"toggleListItem\"] { font-size: var(--zr-corps-editeur); line-height: 1.62; font-weight: var(--zr-corps-poids); }\n\n.md-body, .md-body p, .md-body li, .md-body blockquote { font-size: var(--zr-corps-editeur); line-height: 1.62;\n  font-weight: var(--zr-corps-poids); }\n\n/* ── LES PALIERS D'ÉCRAN ────────────────────────────────────────────────────────\n   UN SEUL nombre change par palier, et toute l'échelle suit. Ces règles vivent ICI et pas dans le bloc de\n   premier rendu d'index.html pour une raison de cascade : ce fichier est chargé APRÈS lui, donc sa déclaration\n   simple `:root { --zr-corps-editeur: 18px }` écraserait n'importe quelle media query écrite là-bas. C'est\n   d'ailleurs ce qui se passait : l'ancien `.md-body { font-size: var(--zr-ui-2xl) }` de la media query mobile était mort,\n   et le téléphone affichait bel et bien le corps de bureau. */\n@media (max-width: 1024px) { :root { --zr-corps-editeur: 16px; } }\n@media (max-width: 640px) {\n  :root {\n    /* La taille reste celle du palier précédent ; seule l'ÉCHELLE se resserre, le titre restant dominant\n       sans occuper trois lignes sur une colonne de 390 px. */\n    --zr-echelle-1: 1.72;\n    --zr-echelle-2: 1.42;\n    --zr-echelle-3: 1.22;\n    --zr-echelle-4: 1.08;\n  }\n}\n\n/* ── LES TITRES DE L'ÉDITEUR, ALIGNÉS SUR CEUX DE LA PAGE ───────────────────────\n   BlockNote pilote la taille de ses titres par une propriété personnalisée `--level` (3em, 2em, 1.3em, 1em,\n   .9em, .8em) que consomme sa propre règle `font-size: var(--level)`. On se branche donc sur CE paramètre\n   plutôt que d'écrire une taille par-dessus : la mécanique reste la sienne, les valeurs deviennent les nôtres.\n   Le préfixe `.bn-editor` ajoute la classe qui fait gagner la spécificité quel que soit l'ordre des feuilles.\n   Deux défauts corrigés au passage, tous deux hérités des valeurs par défaut : un h4 exactement de la taille\n   du corps, et des h5/h6 plus PETITS que lui, donc des titres qui n'en avaient plus l'air. */\n.bn-editor .bn-block-content[data-content-type=\"heading\"] { --level: var(--zr-titre-1); }\n.bn-editor .bn-block-content[data-content-type=\"heading\"][data-level=\"2\"] { --level: var(--zr-titre-2); }\n.bn-editor .bn-block-content[data-content-type=\"heading\"][data-level=\"3\"] { --level: var(--zr-titre-3); }\n.bn-editor .bn-block-content[data-content-type=\"heading\"][data-level=\"4\"] { --level: var(--zr-titre-4); }\n.bn-editor .bn-block-content[data-content-type=\"heading\"][data-level=\"5\"],\n.bn-editor .bn-block-content[data-content-type=\"heading\"][data-level=\"6\"] { --level: var(--zr-corps-editeur); }\n/* Le `font-weight: 700` de BlockNote vit sur un sélecteur à cinq classes : `!important` est ici le moyen le\n   plus court de reprendre la main, et c'est déjà la convention du fichier pour l'éditeur. 600 plutôt que 700\n   parce que la fonte est variable et que le demi-gras suffit à détacher un titre sans l'alourdir. */\n.bn-editor .bn-block-content[data-content-type=\"heading\"] { font-weight: var(--zr-titre-poids) !important; }\n\n/* ===== VideoPlayer2, design A \"Minimal absolu\" (14 October 2026, choix de Matthieu) =====\n   EN: no circle, no capsule. Icons only, with a drop shadow. The progress bar FLOATS above the bottom edge between two side margins; the\n   volume bar sits in the top row, aligned with the other icons. Scoped to .zr-minimal (VideoPlayer2 only): StreamVideo and StreamVideoMSE\n   keep their own look. Every number is a token, changed in ONE place (HDA rule), defaults = the delivered look.\n   FR : aucun cercle ni capsule, icones seules avec ombre portee ; barre de progression flottante entre deux marges ; volume en haut aligne.\n   Portee .zr-minimal (VideoPlayer2 seulement). Chaque nombre est un jeton. */\n:root {\n  --zr-player-bar-bottom: 36px;  /* height of the progress bar above the bottom edge */\n  --zr-player-bar-side: 48px;    /* left and right margin of the bar and of the top row */\n  --zr-player-bar-h: 4px;        /* thickness of the progress and volume bars */\n  --zr-player-top: 22px;         /* distance of the top row from the top edge */\n  --zr-player-row-gap: 22px;     /* space between the icons of the top row */\n  --zr-player-vol-w: 90px;       /* length of the volume bar */\n  --zr-player-icon: 24px;        /* size of the icons (the play icon is 2.5 times larger) */\n  --zr-player-shadow: 1;         /* strength of the drop shadow, 0 = none */\n}\n.zr-video-controls.zr-minimal { padding: 0; }\n.zr-minimal svg {\n  filter:\n    drop-shadow(0 calc(1px * var(--zr-player-shadow)) calc(2px * var(--zr-player-shadow)) rgba(0, 0, 0, calc(.85 * var(--zr-player-shadow))))\n    drop-shadow(0 calc(2px * var(--zr-player-shadow)) calc(8px * var(--zr-player-shadow)) rgba(0, 0, 0, calc(.55 * var(--zr-player-shadow))));\n}\n/* the capsules and circles disappear, the controls keep their size through the icon only */\n.zr-minimal .zr-video-glass,\n.zr-minimal .zr-video-volume-pill,\n.zr-minimal .zr-video-options-pill,\n.zr-minimal .zr-video-option-button,\n.zr-minimal .zr-video-volume-toggle {\n  background: none; border: 0; box-shadow: none; backdrop-filter: none; -webkit-backdrop-filter: none; border-radius: 0;\n  width: auto; height: auto; padding: 4px; color: rgba(255, 255, 255, .92); overflow: visible;\n}\n.zr-minimal .zr-video-glass:hover,\n.zr-minimal .zr-video-glass:active { background: none; border-color: transparent; transform: none; color: #fff; }\n.zr-minimal .zr-video-option-button:hover,\n.zr-minimal .zr-video-volume-toggle:hover { background: none; color: #fff; }\n.zr-minimal .zr-video-top-row {\n  position: absolute; top: var(--zr-player-top); right: var(--zr-player-bar-side);\n  display: flex; align-items: center; gap: var(--zr-player-row-gap);\n}\n.zr-minimal .zr-video-top-row svg { width: var(--zr-player-icon); height: var(--zr-player-icon); }\n.zr-minimal .zr-video-volume-pill { display: flex; align-items: center; gap: 8px; padding: 0; }\n.zr-minimal .zr-video-volume { width: var(--zr-player-vol-w); flex: none; }\n.zr-minimal .zr-video-bottom-right { position: relative; right: auto; bottom: auto; gap: 0; }\n.zr-minimal .zr-video-options-pill { display: flex; align-items: center; gap: var(--zr-player-row-gap); padding: 0; }\n.zr-minimal .zr-video-settings-menu { top: calc(100% + 12px); bottom: auto; right: 0; }\n.zr-minimal .zr-video-settings-menu svg { filter: none; }\n/* centre: the play icon is large, the 10 second jumps stay discreet */\n.zr-minimal .zr-video-play-center { width: auto; height: auto; padding: 0; }\n.zr-minimal .zr-video-play-center svg { width: calc(var(--zr-player-icon) * 2.5); height: calc(var(--zr-player-icon) * 2.5); }\n.zr-minimal .zr-video-control-md { opacity: .75; padding: 0; }\n.zr-minimal .zr-video-control-md:hover { opacity: 1; }\n.zr-minimal .zr-video-control-md svg { width: calc(var(--zr-player-icon) * 1.15); height: calc(var(--zr-player-icon) * 1.15); }\n/* the floating progress bar: no capsule, detached from the bottom edge, anchored toward the bottom */\n.zr-minimal .zr-video-bottom.zr-video-seek-pill {\n  left: var(--zr-player-bar-side); right: var(--zr-player-bar-side); bottom: var(--zr-player-bar-bottom);\n  height: auto; padding: 0; gap: 16px; grid-template-columns: auto minmax(0, 1fr) auto;\n  background: none; border: 0; border-radius: 0; box-shadow: none; backdrop-filter: none; -webkit-backdrop-filter: none;\n}\n.zr-minimal .zr-video-time { text-shadow: 0 calc(1px * var(--zr-player-shadow)) 2px rgba(0, 0, 0, .9), 0 2px 8px rgba(0, 0, 0, .6); }\n.zr-minimal .zr-video-seek::-webkit-slider-runnable-track,\n.zr-minimal .zr-video-volume::-webkit-slider-runnable-track { height: var(--zr-player-bar-h); box-shadow: 0 1px 3px rgba(0, 0, 0, .6); }\n.zr-minimal .zr-video-seek::-webkit-slider-thumb,\n.zr-minimal .zr-video-volume::-webkit-slider-thumb { margin-top: calc((var(--zr-player-bar-h) - 12px) / 2); }\n.zr-minimal .zr-video-seek::-moz-range-track,\n.zr-minimal .zr-video-volume::-moz-range-track,\n.zr-minimal .zr-video-seek::-moz-range-progress,\n.zr-minimal .zr-video-volume::-moz-range-progress { height: var(--zr-player-bar-h); }\n@media (max-width: 700px) {\n  .zr-video-controls.zr-minimal { --zr-player-bar-side: 16px; --zr-player-bar-bottom: 18px; --zr-player-top: 12px; --zr-player-row-gap: 12px; --zr-player-vol-w: 64px; --zr-player-icon: 22px; }\n}\n"],"detail":"<header class=\"zrp-detail-head\"><textarea class=\"zrp-detail-title\" rows=\"1\" aria-label=\"Task title\" style=\"height: 109px;\">10 à 100 mails aux studios : Exécution Andreas Method,…</textarea><div class=\"zrp-detail-tools\"><button type=\"button\" class=\"zrp-detail-icon\" title=\"Images\" aria-label=\"Add images\"><svg width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" style=\"display: block; flex-shrink: 0; color: currentcolor;\"><rect x=\"3.5\" y=\"5\" width=\"17\" height=\"14\" rx=\"2.4\"></rect><circle cx=\"8.5\" cy=\"10\" r=\"1.6\"></circle><path d=\"M5 18l4.5-4.5 3.5 3 3-3L19 17\"></path></svg></button><button type=\"button\" class=\"zrp-detail-icon\" title=\"Abandonner : la tâche reste, elle ne compte plus\" aria-label=\"Abandonner la tâche\" aria-pressed=\"false\"><svg class=\"zrp-dropped-mark\" viewBox=\"0 0 30.8789 30.5508\" aria-hidden=\"true\" focusable=\"false\"><path fill=