/* Placeholder éditeur (BlockNote) : il est injecté au RUNTIME sur le pseudo `:before` des blocs vides marqués
   [data-is-empty-and-focused] (PAS [data-placeholder]) -> on cible CE sélecteur. !important bat la règle injectée.
   Gris foncé lisible en clair, clair en sombre (sinon texte d'invite quasi blanc, illisible). */
[data-is-empty-and-focused]:before,
[data-is-only-empty-block]:before,
[data-placeholder]:before,
.bn-editor [data-is-empty-and-focused]:before,
.bn-editor [data-is-only-empty-block]:before,
.bn-editor [data-placeholder]:before,
.bn-editor .is-empty:before,
.bn-editor .is-editor-empty:before { color: #1F1F1E !important; -webkit-text-fill-color: #1F1F1E !important; opacity: 1 !important; }
[data-color-scheme="dark"] [data-is-empty-and-focused]:before,
[data-color-scheme="dark"] [data-is-only-empty-block]:before { color: rgba(236,236,234,0.55) !important; }

/* PLACEHOLDER « lettre par lettre » : le natif (::after, texte insécable) est MASQUÉ ; un overlay React le remplace
   (1 span animé/lettre, vague d'opacité). Animation .zr-ph-letter définie aussi dans index.html. */
/* Éditeurs SANS overlay (Articles) : natif visible NOIR ; éditeur AVEC overlay (.zr-ph-custom) : natif masqué. */
.bn-editor .bn-block-content:has(.ProseMirror-trailingBreak:only-child)::after,
.bn-block-content:has(.ProseMirror-trailingBreak:only-child)::after { color: #1F1F1E !important; -webkit-text-fill-color: #1F1F1E !important; opacity: 1 !important; }
.zr-dark .bn-block-content:has(.ProseMirror-trailingBreak:only-child)::after,
[data-color-scheme="dark"] .bn-block-content:has(.ProseMirror-trailingBreak:only-child)::after { color: rgba(236,236,234,0.62) !important; -webkit-text-fill-color: rgba(236,236,234,0.62) !important; }
.zr-ph-custom .bn-block-content:has(.ProseMirror-trailingBreak:only-child)::after { color: transparent !important; -webkit-text-fill-color: transparent !important; }
.zr-ph-letter { opacity: .45; animation: zr-ph-letter 2.4s linear infinite; will-change: opacity; }
@keyframes zr-ph-letter { 0% { opacity: .45 } 50% { opacity: 1 } 100% { opacity: .45 } }
@media (prefers-reduced-motion: reduce) { .zr-ph-letter { animation: none !important; opacity: .6 !important; } }

/* Bloc code (BlockNote) : deux bugs signalés par Matthieu 2026-07-12.
   1) Aucune marge entre blocs consécutifs -> deux blocs code l'un sous l'autre se touchaient (même fond gris,
      lisent comme UN SEUL bloc fusionné) -> margin-bottom.
   2) Le rayon d'arrondi (10px) était FIXE, donc identique sur un bloc court ou long -> jamais franchement une
      capsule. Mécanique CSS utilisée : un rayon proche de la MOITIÉ de la hauteur "1 ligne" (52px -> ~26px) se
      CLAMPE automatiquement à un plein stade/capsule tant que le bloc tient sur 1 ligne (52px de haut), puis
      redevient un simple rectangle arrondi dès qu'une 2e ligne apparaît (76px, le même rayon ne fait plus la
      moitié de la hauteur) -> aucune media query, aucun JS, le seul fait de fixer un rayon plus grand suffit.
   Padding latéral élargi en même temps (16px -> 22px) pour que le texte ne frôle jamais le bord incurvé. */
.bn-editor .bn-block-content[data-content-type="codeBlock"] {
  border-radius: 26px !important;
  padding: 14px 22px !important;
  margin-bottom: 8px !important;
}

/* E9 — ergonomie mobile (<=480px, iPhone 15 Pro ~390px). Purement additif : aucun effet hors telephone.
   jamais de scroll horizontal parasite ; medias bornes a la largeur ecran ; safe-area utilitaires. Les grilles
   Finder/Drive/Archives utilisent deja auto-fill minmax -> 1-2 colonnes a 390px, rien a forcer. */
/* spinner de chargement du lecteur vidéo (VideoPlayer2). */
@keyframes zr-spin { to { transform: rotate(360deg); } }

/* boutons du lecteur vidéo (VideoPlayer2, 2026-07-05) : feedback survol/appui façon YouTube — fondu léger
   au survol, petit "ping pong" (scale) à l'appui. Volontairement très simple, 2 règles seulement. Les
   styles inline (background, border-radius) posés par chaque bouton restent maîtres ; ces règles n'ajoutent
   que transition/hover/active, jamais de conflit de spécificité avec l'inline. */
.zr-ctrl-btn { transition: background-color var(--g9-timing, .35s) var(--g9-ease, ease), transform var(--g9-timing, .35s) var(--g9-ease, ease); }
.zr-ctrl-btn:hover { background-color: rgba(255,255,255,0.14); }

/* Le sous-menu contextuel Finder est rendu conditionnellement après un clic explicite. Le hover ne pilote
   jamais sa navigation : il ne conserve ici que le feedback visuel générique de .zr-treeitem. */
.zr-ctrl-btn:active { transform: scale(0.88); }
@media (prefers-reduced-motion: reduce) {
  .zr-ctrl-btn { transition: none !important; }
  .zr-ctrl-btn:active { transform: none !important; }
}

