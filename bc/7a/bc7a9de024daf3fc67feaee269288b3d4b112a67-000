// 26 October 2026, 14:00 Paris: Preserve the previous Plan in Design without replacing unrelated entries.
import fs from 'node:fs/promises';import path from 'node:path';import {execFileSync} from 'node:child_process';
const CONFIG={base:'https://zenray-progress.pages.dev',gallery:'pages/Design/design.json',folderId:'zenray-plan-before-26-october-2026',folderName:'ZenRay Plan, ancien design, 26 October 2026',out:path.resolve(import.meta.dirname,'../OldPlan')};
const secret=execFileSync('security',['find-generic-password','-a','zenray','-s','zenray-progress-api','-w'],{encoding:'utf8'}).trim();
async function request(url,body){const r=await fetch(CONFIG.base+url,{method:body?'POST':'GET',headers:{'x-zr-auth':secret,...(body?{'content-type':'application/json'}:{})},...(body?{body:JSON.stringify(body)}:{})});const j=await r.json();if(!r.ok)throw Error('HTTP '+r.status);return j}
async function read(){const j=await request('/api/page?action=read&fresh=1&path='+encodeURIComponent(CONFIG.gallery));if(!j.sha||!j.markdown)throw Error('Gallery unreadable');return{sha:j.sha,data:JSON.parse(j.markdown)}}
let current=await read();if(current.data.items.some(i=>i.id===CONFIG.folderId)&&!process.argv.includes('--refresh')){console.log('Archive already in Design');process.exit(0)}
const items=[];for(const theme of ['dark','light']){const file=path.join(CONFIG.out,`ZenRay-Plan-Old-${theme}-26-October-2026.png`);const data=await fs.readFile(file);const j=await request('/api/img',{dataUrl:'data:image/png;base64,'+data.toString('base64'),dir:'uploads'});if(!j.path)throw Error('Image upload failed');items.push({id:CONFIG.folderId+'-'+theme,kind:'image',path:j.path,name:`ZenRay Plan, ancien design ${theme==='dark'?'sombre':'clair'}, 26 October 2026`,w:1920,h:1200,addedAt:new Date().toISOString()});}
for(let n=0;n<5;n++){current=await read();const next={...current.data,items:[{id:CONFIG.folderId,kind:'folder',name:CONFIG.folderName,items,addedAt:new Date().toISOString()},...current.data.items.filter(i=>i.id!==CONFIG.folderId)]};const saved=await request('/api/page',{action:'save',path:CONFIG.gallery,markdown:JSON.stringify(next),sha:current.sha});if(saved.ok)break;if(!saved.conflict)throw Error('Gallery save failed');}
const verified=await read();const folder=verified.data.items.find(i=>i.id===CONFIG.folderId);if(folder?.items.length!==2)throw Error('Archive verification failed');for(const i of folder.items){const r=await fetch(CONFIG.base+'/api/img?path='+encodeURIComponent(i.path));if(!r.ok||!(await r.arrayBuffer()).byteLength)throw Error('Archive image unreadable')}
await fs.writeFile(path.join(CONFIG.out,'GalleryReceipt.json'),JSON.stringify({date:'26 October 2026',gallery:CONFIG.gallery,folder,verified:true},null,2));console.log('Design gallery: old light and dark screenshots saved and both remote images read back.');
